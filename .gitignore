# ── Deployment (Render) ──────────────────────────────────────────────
# The Node server has zero runtime dependencies, so node_modules is only
# ever created by tooling.
/node_modules/
/swift-fleet-api/node_modules/

# The compiled Flutter web bundle served by swift-fleet-api/server.js.
# Generated by `npm run build:web`. Ignored because the default Render
# blueprint compiles Flutter in the cloud — see DEPLOY.md.
# If you switch to the prebuilt deploy (Option B), DELETE the line below
# so the bundle gets committed.


# Local environment overrides
.env
.env.local

